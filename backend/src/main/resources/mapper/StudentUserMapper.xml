<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.campus.jobs.mapper.StudentUserMapper">
  <resultMap id="student" type="cn.campus.jobs.entity.StudentUser" autoMapping="false">
    <constructor>
      <arg resultMap="cn.campus.jobs.mapper.AccountMapper.accountFields" javaType="cn.campus.jobs.entity.AccountFields"/>
      <arg column="school" javaType="java.lang.String"/>
      <arg column="name_cipher" javaType="java.lang.String"/>
      <arg column="student_number_cipher" javaType="java.lang.String"/>
      <arg column="grade" javaType="java.lang.String"/>
      <arg column="major" javaType="java.lang.String"/>
      <arg column="can_accept" javaType="_int"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="student">
    SELECT * FROM student_user WHERE id=#{id}<if test="lock"> FOR UPDATE</if>
  </select>
  <select id="findByAccount" resultMap="student">
    SELECT * FROM student_user WHERE account_hash=#{hash}
  </select>
  <insert id="insert">
    INSERT INTO student_user(id,account_hash,phone_cipher,password_hash)
    VALUES(#{id},#{hash},#{phoneCipher},#{passwordHash})
  </insert>
</mapper>
