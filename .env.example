# 更换为自己的用户名和密码
DB_NAME=campusjobs
DB_USERNAME=root
DB_PASSWORD=replace-with-a-strong-database-password
# 输入密码
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_DATABASE=0
REDIS_TIMEOUT=3s
# 设置为自己主机设置的端口号
DB_HOST=127.0.0.1
DB_PORT=3306
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

APP_ENCRYPTION_KEY=base64-of-32-random-bytes
APP_LOOKUP_KEY=at-least-32-random-characters-separate-from-encryption-key

APP_MODE=dev
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088

APP_SECURE_COOKIE=false
WALLET_MODE=SIMULATED
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# 审核管理员
REVIEW_ADMIN_USERNAME=campus_admin
REVIEW_ADMIN_PASSWORD=replace-with-12-to-64-characters-with-letters-and-digits
